<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12211C"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#ECE3D2"
        android:textSize="22sp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/currentLevelText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9FAE9C"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dhuhr / Prayer time"
        android:textColor="#C4914F"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/dhuhrAutoSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculate automatically (Riyadh)"
        android:textColor="#ECE3D2"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/manualTimeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9FAE9C"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/setManualTimeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set manual time"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/changeLevelButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change classroom level" />

</LinearLayout>
